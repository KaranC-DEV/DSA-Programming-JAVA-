package array.sliding_window;

public class FindMaxLengthOfsubarray {

	public static void main(String[] args) {
		int arr[]= {2,1,5,1,3,2};
		int k=6;
		
		
		System.out.println(maxSubArrayLen(arr,k));

	}
	
	public static int maxSubArrayLen( int[] arr, int k) {
	      
	       int left=0, max=Integer.MIN_VALUE,sum=0;
			int right=0;
			while(right<arr.length) {
	                sum+=arr[right];
	                while(sum<=k){
	                    
	                    max=Math.max(right-left+1,max);
	                    sum -= arr[left];
	                    right++;
	                    
	                }
	                while(sum>k)
	                left++;
				}
	            
				
			return max;	
			}
			
		}


