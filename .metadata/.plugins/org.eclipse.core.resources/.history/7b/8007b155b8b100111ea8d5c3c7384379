package array.sliding_window;

public class FindCountSubarrayGreaterThanX {

	public static void main(String[] args) {
		int arr[]= {2,1,5,1,3,2};
		int k=3,x=6;
		
		
		System.out.println(maxSum(arr,k,x));
	}

	public static int maxSum(int[] arr, int k,int x) {
		
		
		int left=0 ,count=0 ,currentSum=0;
		for(int right=0;right<arr.length;right++) {
			
			currentSum+=arr[right];
			if(right-left+1==k) {
				
				if(currentSum>x)
					count++;
				currentSum -=arr[left];
				left++;
			}
			
		}
		return count;
	}

}
